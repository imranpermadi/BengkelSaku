# ==============================================================================
# BENGKELSAKU ENVIRONMENT VARIABLES
# ==============================================================================

# NEXTAUTH (AUTH.JS v5)
# Generate random secret with: openssl rand -base64 32
AUTH_SECRET="bengkelsaku-development-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:4000"

# GOOGLE OAUTH SSO
# Daftar di Google Cloud Console: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# DATABASE (POSTGRESQL 18 LOCALHOST)
DATABASE_URL="postgresql://postgres:server!2345@localhost:5432/BengkelSaku?schema=public"

# AI ENGINE (VERCEL AI SDK)
# Google Gemini API: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Groq Cloud API: https://console.groq.com/keys
GROQ_API_KEY=""

# EXTERNAL APIS
# YouTube Data API v3: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""

# APP ENVIRONMENT
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:4000"
